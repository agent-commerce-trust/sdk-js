{
  "name": "@agent-commerce-trust/core",
  "version": "0.1.0-rc.1",
  "description": "Shared primitives for Agent Commerce Trust packages.",
  "author": "Airheart, Inc.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js",
      "require": "./dist/dev/index.cjs"
    },
    "./providers": null
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SECURITY_REVIEW_rc1.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/dev/index.ts --format esm,cjs --sourcemap --clean --out-dir dist && tsc -p tsconfig.json --emitDeclarationOnly --declarationDir dist && node scripts/mirror-dts-to-cts.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20"
  }
}
