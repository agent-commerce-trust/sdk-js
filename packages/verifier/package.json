{
  "name": "@agent-commerce-trust/verifier",
  "version": "0.1.0-rc.0",
  "description": "Receipt and cancellation-proof verifier for Agent Commerce Trust.",
  "author": "Airheart, Inc.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir dist",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-commerce-trust/core": "0.1.0-rc.1",
    "@ap2-travel/profile": "^0.1.0-rc.1"
  },
  "engines": {
    "node": ">=20"
  }
}
